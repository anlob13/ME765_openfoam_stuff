FoamFile
{
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

epsInlet         1e-4;

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform $epsInlet;

boundaryField
{
    freestream
    {
        type            inletOutlet;
        inletValue      uniform $epsInlet;
        value           uniform $epsInlet;
    }

    wall
    {
        type            epsilonWallFunction;
        value           uniform $epsInlet;
    }

}

