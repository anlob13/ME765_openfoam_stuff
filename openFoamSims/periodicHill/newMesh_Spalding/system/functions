fieldAverage1
{
    type            fieldAverage;
    libs            ("libfieldFunctionObjects.so");
    timeStart       0;
    executeControl  timeStep;
    executeInterval 1;
    writeControl    writeTime;
    restartOnOutput true;

    fields
    (
        U
        {
            mean        on;
            prime2Mean  on;
            base        time;
        }
        p
        {
            mean        on;
            prime2Mean  off;
            base        time;
        }
        wallShearStress
        {
            mean        on;
            prime2Mean  off;
            base        time;
        }
    );
}
